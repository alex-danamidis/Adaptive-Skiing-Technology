            if command in VALID_COMMANDS:
                # Simulated FR5 / UC11: Audio loopback to instructor earpiece
                print(f"[Loopback Audio] Playback to instructor: \"{command.upper()}\" ✓")
                # Simulated FR8 / UC09: Send haptic signal to bracelets
                print(f"[Haptic Output] Transmitting vibration pattern for '{command.upper()}' to wristbands.\n")
            else:
                # Simulated UC07: Reject unrecognized commands
                print(f"[Failsafe] Warning: '{command}' is not a valid command. Command rejected. Re-prompt instructor.\n")

        except sr.WaitTimeoutError:
            print("[System] Listening timed out. No speech detected.\n")
        except sr.UnknownValueError:
