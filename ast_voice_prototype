import speech_recognition as sr
import time

def run_ast_voice_prototype():
    # Initialize recognizer and microphone
    recognizer = sr.Recognizer()
    mic = sr.Microphone()

    # Valid commands supported by the AST system requirements
    VALID_COMMANDS = ["left", "right", "stop"]
    
    print("=== AST Voice Recognition Prototype Initialized ===")
    print("Ready for instructor commands ('left', 'right', 'stop')... Press Ctrl+C to exit.\n")

    # Adjust for ambient noise (simulating FR3 background noise handling)
    with mic as source:
        print("[System] Adjusting for ambient noise... Please remain quiet.")
        recognizer.adjust_for_ambient_noise(source, duration=1.0)
        print("[System] Noise baseline set. System ready.\n")

    while True:
        try:
            with mic as source:
                print("[Instructor] Listening for command (Push-to-Talk active)...")
                # Listen to the microphone input
                audio = recognizer.listen(source, timeout=5.0, phrase_time_limit=3.0)
            
            print("[System] Processing and filtering audio...")
            start_time = time.time()

